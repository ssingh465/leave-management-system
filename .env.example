# ============================================================================
# Leave Management System - Environment Variables (Example Template)
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values before running the system.
# Every variable defined here must be present in `.env` for the services to
# start correctly. See the README for descriptions.
# ============================================================================

# --- JWT ---
# Used by python-jose to sign and verify access tokens. MUST be a long,
# unguessable random string in any non-development environment.
JWT_SECRET_KEY=replace-with-a-long-random-string

# Signing algorithm. The project standardises on HS256.
JWT_ALGORITHM=HS256

# Token lifetime in minutes.
JWT_EXPIRATION_MINUTES=60

# --- RabbitMQ ---
# Connection URL used by both publishers (in-app) and the Notification
# Service consumer. When running under docker-compose the host is the
# service name `rabbitmq`.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# --- Consul ---
# HTTP API of the Consul agent used for service registration and resolution.
CONSUL_URL=http://consul:8500

# --- Per-service identity ---
# Overridden per-service in docker-compose.yml. Leave the defaults here.
SERVICE_NAME=unknown-service
SERVICE_HOST=localhost
SERVICE_PORT=8000
